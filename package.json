{
  "name": "@smplcty/schema-std",
  "version": "0.0.0",
  "description": "Standard, parameterized PostgreSQL schema building blocks (audit, soft-delete, timestamps) consumed via @smplcty/schema-flow imports.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mabulu-inc/simplicity-schema-std.git"
  },
  "homepage": "https://github.com/mabulu-inc/simplicity-schema-std#readme",
  "bugs": {
    "url": "https://github.com/mabulu-inc/simplicity-schema-std/issues"
  },
  "type": "module",
  "files": [
    "schema",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "postgres",
    "schema",
    "schema-flow",
    "audit",
    "soft-delete",
    "mixins"
  ],
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky",
    "release": "GITHUB_TOKEN=$(gh auth token) release-it",
    "release:patch": "GITHUB_TOKEN=$(gh auth token) release-it patch",
    "release:minor": "GITHUB_TOKEN=$(gh auth token) release-it minor",
    "release:major": "GITHUB_TOKEN=$(gh auth token) release-it major"
  },
  "lint-staged": {
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@release-it/keep-a-changelog": "^7.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "release-it": "^20.2.0"
  }
}

{
  "name": "@smplcty/schema-std",
  "version": "0.1.0",
  "description": "Standard, parameterized PostgreSQL schema building blocks (audit, soft-delete, timestamps) consumed via @smplcty/schema-flow imports.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mabulu-inc/simplicity-schema-std.git"
  },
  "homepage": "https://mabulu-inc.github.io/simplicity-schema-std",
  "bugs": {
    "url": "https://github.com/mabulu-inc/simplicity-schema-std/issues"
  },
  "type": "module",
  "files": [
    "schema",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "postgres",
    "schema",
    "schema-flow",
    "audit",
    "soft-delete",
    "mixins"
  ],
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky",
    "release": "GITHUB_TOKEN=$(gh auth token) release-it",
    "release:patch": "GITHUB_TOKEN=$(gh auth token) release-it patch",
    "release:minor": "GITHUB_TOKEN=$(gh auth token) release-it minor",
    "release:major": "GITHUB_TOKEN=$(gh auth token) release-it major"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@release-it/keep-a-changelog": "^8.0.1",
    "@smplcty/schema-flow": "^0.24.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "release-it": "^21.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
